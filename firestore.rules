rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      // Lectura pública del ranking
      allow read: if true;
      
      // Escritura permitida con validación estricta de estructura y tipos
      allow write: if request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 4
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 5000000
        && request.resource.data.streak is int
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 5000;
    }

    // Bloquear acceso a cualquier otra colección no autorizada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
